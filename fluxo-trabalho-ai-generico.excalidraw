    {
      "id": "rCuZWyjEaAdL2eHCXvesv",
      "type": "text",
      "x": 180.14079903305628,
      "y": 428.8145598570518,
      "width": 954.2426147460939,
      "height": 320.63827514648426,
      "angle": 0,
      "strokeColor": "#ffffff",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
