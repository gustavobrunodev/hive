      "versionNonce": 856426939,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790002354360,
      "link": null,
      "locked": false,
      "text": "Se focarmos em ferramenta, temos o\nrisco de a forma que pensamos não\nser a forma que as pessoas\ntrabalham/desejam trabalhar (risco\nmaior)",
      "fontSize": 51.30212402343747,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se focarmos em ferramenta, temos o\nrisco de a forma que pensamos não ser a forma que as pessoas trabalham/desejam trabalhar (risco maior)",
      "autoResize": false,
      "lineHeight": 1.25
    },
