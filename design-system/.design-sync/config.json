{
  "projectId": "0fd7aade-a9af-4bc3-aa08-4073212d47d1",
  "pkg": "@hive/design-system",
  "globalName": "Hive",
  "shape": "storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "npm run build",
  "cssEntry": "dist/ds-bundle.css",
  "extraFonts": [".design-sync/fonts/google-fonts.css"],
  "readmeHeader": ".design-sync/conventions.md",
  "titleMap": {
    "Timeline": "Step"
  },
  "extraEntries": ["./.design-sync/entries/card-backdrop.tsx"],
  "provider": {"component": "CardBackdrop"},
  "overrides": {
    "PromptInput": {"cardMode": "column"},
    "SkillCard": {"cardMode": "column"},
    "Field": {"cardMode": "column"},
    "Select": {"cardMode": "single", "primaryStory": "Default"},
    "Nav": {"cardMode": "column"},
    "Step": {"cardMode": "column"},
    "Command": {"cardMode": "column"},
    "Logo": {"skip": [
      "brand-logo--default",
      "brand-logo--full",
      "brand-logo--brain",
      "brand-logo--with-description",
      "brand-logo--black-tone",
      "brand-logo--white-tone",
      "brand-logo--unavailable-combination"
    ]}
  }
}
