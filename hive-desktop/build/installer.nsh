; build/installer.nsh — the Hive installer's own pages and copy.
;
; electron-builder generates the NSIS script and inserts these macros at fixed
; points (see app-builder-lib/templates/nsis/assistedInstaller.nsh). Only the
; macro names below exist; anything else here is silently never run.
;
; What this file adds to the stock assisted flow:
;   - a welcome page, which the stock flow has none of (it opens straight on
;     "install for whom?", a question with no context in front of it);
;   - a finish page that says where Hive went and offers to open it;
;   - a matching pair for the uninstaller, so leaving is as clear as arriving.
;
; The artwork these pages sit on (sidebar, header, icons) is configured in
; electron-builder.yml and generated by `npm run build:brand-artwork`.
;
; Copy is pt-BR, like the app. `$(^Name)` / `${PRODUCT_NAME}` resolve to
; "Hive"; `$INSTDIR` to the chosen install directory.

!macro customHeader
  ; Replaces the stock "Hive 0.1.0" strip at the bottom of every page.
  BrandingText "Hive · fluxos do BMAD sem terminal"
!macroend

; ---------------------------------------------------------------------------
; "Is the app still running?" — replaces electron-builder's stock check, which
; blocks this app in two ways that a user cannot get out of.
;
; The stock check (templates/nsis/include/allowOnlyOneInstallerInstance.nsh)
; matches processes with `$_.Path.StartsWith('$INSTDIR')` — a raw string
; prefix, no path separator, and not by executable name at all.
;
;  1. `…\Programs\Hive` is a case-insensitive string prefix of
;     `…\Programs\hive-desktop`. With the pre-rename install still on the
;     machine, the new installer reports the OLD app as "Hive" and refuses to
;     continue. Matching `$INSTDIR\` makes it a directory match again.
;
;  2. Hive ships the agent CLI inside its own folder
;     (`resources\app.asar.unpacked\node_modules\@anthropic-ai\claude-code\
;     bin\claude.exe`). A turn can leave one alive after the window is gone,
;     and the path-prefix match finds it — so the stock dialog says "close the
;     Hive window and click Retry" when there is no window to close, and Retry
;     loops forever. That is the dead end this macro exists to remove: the
;     first kill pass is forced (a headless console child ignores the polite
;     one), and if something still survives the message NAMES it instead of
;     pointing at a window that isn't there.
;
; The match is deliberately scoped to `$INSTDIR\` and never to a bare image
; name: the user very likely has their own `claude.exe` on PATH, and killing
; that would be this installer reaching outside its own folder.
; ---------------------------------------------------------------------------

!macro hiveFindRunning
  ; Exit 10 = something under $INSTDIR is running (its process names are on
  ; stdout); 11 = clear; anything else = PowerShell unusable, fall back.
  StrCpy $HiveRunNames ""
  nsExec::ExecToStack `"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -C "$$p = @(Get-CimInstance -ClassName Win32_Process | Where-Object { $$_.Path -and $$_.Path.StartsWith('$INSTDIR\', 'CurrentCultureIgnoreCase') }); if ($$p.Count -gt 0) { Write-Output (($$p | ForEach-Object { $$_.Name } | Sort-Object -Unique) -join ', '); exit 10 } else { exit 11 }"`
  Pop $0
  Pop $1
  ${If} $0 == 10
    StrCpy $HiveRunState "running"
    StrCpy $HiveRunNames $1
  ${ElseIf} $0 == 11
    StrCpy $HiveRunState "clear"
  ${Else}
    ; No usable PowerShell. Fall back to an exact image-name match on the app
    ; executable only — the stock behaviour, and the most this can safely do
    ; without a path to scope by.
    nsExec::Exec `"$SYSDIR\cmd.exe" /C tasklist /FI "IMAGENAME eq ${APP_EXECUTABLE_FILENAME}" /FO CSV /NH | "$SYSDIR\findstr.exe" /B /I /C:"\"${APP_EXECUTABLE_FILENAME}\""`
    Pop $0
    ${If} $0 == 0
      StrCpy $HiveRunState "running"
      StrCpy $HiveRunNames "${APP_EXECUTABLE_FILENAME}"
    ${Else}
      StrCpy $HiveRunState "clear"
    ${EndIf}
  ${EndIf}
!macroend

!macro hiveKillRunning
  nsExec::Exec `"$SYSDIR\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -NonInteractive -C "Get-CimInstance -ClassName Win32_Process | Where-Object { $$_.Path -and $$_.Path.StartsWith('$INSTDIR\', 'CurrentCultureIgnoreCase') } | ForEach-Object { Stop-Process -Id $$_.ProcessId -Force -ErrorAction SilentlyContinue }"`
  Pop $0
  ${If} $0 != 0
    nsExec::Exec `"$SYSDIR\cmd.exe" /C taskkill /F /IM "${APP_EXECUTABLE_FILENAME}" /FI "USERNAME eq %USERNAME%"`
    Pop $0
  ${EndIf}
!macroend

!macro customCheckAppRunning
  Var /GLOBAL HiveRunState
  Var /GLOBAL HiveRunNames
  Var /GLOBAL HiveRunTries

  ; Nothing installed here yet, so nothing can be running from here. Also the
  ; guard that keeps a first-ever install from paying for any of the above.
  ${IfNot} ${FileExists} "$INSTDIR\${APP_EXECUTABLE_FILENAME}"
    Goto hiveNothingRunning
  ${EndIf}

  StrCpy $HiveRunTries 0

  hiveCheck:
    !insertmacro hiveFindRunning
    ${If} $HiveRunState != "running"
      Goto hiveNothingRunning
    ${EndIf}

    ${If} $HiveRunTries >= 3
      MessageBox MB_RETRYCANCEL|MB_ICONEXCLAMATION "Ainda há algo do Hive em execução:$\r$\n$HiveRunNames$\r$\n$\r$\nSe nenhuma janela do Hive estiver aberta, é um processo de agente que ficou rodando em segundo plano. Encerre-o pelo Gerenciador de Tarefas e clique em Repetir." /SD IDCANCEL IDRETRY hiveRetry
      Quit
      hiveRetry:
        StrCpy $HiveRunTries 0
        Goto hiveCheck
    ${EndIf}

    IntOp $HiveRunTries $HiveRunTries + 1
    DetailPrint "$(appClosing)"
    !insertmacro hiveKillRunning
    Sleep 1500
    Goto hiveCheck

  hiveNothingRunning:
!macroend

!macro customWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Bem-vindo ao Hive"
  !define MUI_WELCOMEPAGE_TEXT "O Hive dá uma superfície visual ao BMAD: conversar com agentes, rodar fluxos e ler os artefatos que eles produzem — sem abrir um terminal.$\r$\n$\r$\nA instalação leva alguns segundos. Nas próximas telas você escolhe para quem instalar e em qual pasta.$\r$\n$\r$\nClique em Próximo para começar."
  !insertmacro MUI_PAGE_WELCOME
!macroend

!macro customFinishPage
  ; Launches the app as the logged-in user even when the installer itself was
  ; elevated — starting a desktop app as Administrator is how a first run ends
  ; up writing its config into the wrong profile. Mirrors what electron-builder
  ; does in its own default finish page.
  Function StartApp
    ${if} ${isUpdated}
      StrCpy $1 "--updated"
    ${else}
      StrCpy $1 ""
    ${endif}
    ${StdUtils.ExecShellAsUser} $0 "$launchLink" "open" "$1"
  FunctionEnd

  !define MUI_FINISHPAGE_TITLE "O Hive está pronto"
  !define MUI_FINISHPAGE_TEXT "O Hive foi instalado em:$\r$\n$INSTDIR$\r$\n$\r$\nHá um atalho na área de trabalho e no menu Iniciar. Na primeira execução o Hive prepara o BMAD e pergunta qual pasta você quer usar como workspace."
  !define MUI_FINISHPAGE_RUN
  !define MUI_FINISHPAGE_RUN_TEXT "Abrir o Hive agora"
  !define MUI_FINISHPAGE_RUN_FUNCTION "StartApp"
  !insertmacro MUI_PAGE_FINISH
!macroend

!macro customUnWelcomePage
  !define MUI_WELCOMEPAGE_TITLE "Desinstalar o Hive"
  !define MUI_WELCOMEPAGE_TEXT "O Hive será removido deste computador.$\r$\n$\r$\nSuas conversas, configurações e a base de conhecimento continuam no disco — remover o aplicativo não apaga o que você produziu com ele. Seus arquivos de workspace nunca são tocados.$\r$\n$\r$\nClique em Próximo para continuar."
  !insertmacro MUI_UNPAGE_WELCOME
!macroend
